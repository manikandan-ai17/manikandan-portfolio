{
  "manifest_version": 3,
  "name": "Job Application Assistant",
  "version": "0.1.0",
  "description": "Finds AI roles that match your verified profile, explains the fit, fills application forms and tracks what you applied to. Never submits for you.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Job Application Assistant",
    "default_popup": "pages/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "options_page": "pages/profile.html",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://boards-api.greenhouse.io/*",
    "https://api.ashbyhq.com/*",
    "https://api.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://api.github.com/*",
    "https://manikandan-portfolio-delta.vercel.app/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*"
      ],
      "js": ["src/content/fieldmap.js", "src/content/autofill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
